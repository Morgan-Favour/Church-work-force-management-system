generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  password     String
  role         UserRole
  departmentId String?
  workerId     String?
 

  worker       Worker?  @relation(fields: [workerId], references: [id])

  leaderDepartments LeaderDepartment[]
   createdInvites Invite[]

  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  isActive    Boolean  @default(true)

  workers     WorkerDepartment[]
  leaders     LeaderDepartment[]
  attendance  Attendance[]
  activities  ActivityLog[]
  inviteDepartments InviteDepartment[]
  pendingLeaderDepartments PendingLeaderDepartment[]

pendingWorkerDepartments PendingWorkerDepartment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Worker {
  id          String   @id @default(cuid())
  fullName    String
  phone       String?  @unique
  gender      String?

  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())

  departments WorkerDepartment[]
  attendance  Attendance[]
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkerDepartment {
  id           String @id @default(cuid())
  workerId     String
  departmentId String

  worker       Worker     @relation(fields: [workerId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt    DateTime @default(now())

  @@unique([workerId, departmentId])
}

model LeaderDepartment {
  id           String @id @default(cuid())

  userId       String
  departmentId String

  user         User @relation(fields: [userId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt    DateTime @default(now())

  @@unique([userId, departmentId])
}

model Service {
  id         String   @id @default(cuid())
  title      String
  date       DateTime

  attendance Attendance[]

  createdAt  DateTime @default(now())

  @@unique([title, date])
}

model Attendance {
  id           String @id @default(cuid())

  workerId     String
  serviceId    String
  departmentId String

  status       AttendanceStatus
  markedBy     String?

  worker       Worker     @relation(fields: [workerId], references: [id])
  service      Service    @relation(fields: [serviceId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workerId, serviceId, departmentId])
}

model ActivityLog {
  id           String   @id @default(cuid())
  action       String
  description  String
  actorId      String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt    DateTime @default(now())
}

model Invite {
  id            String   @id @default(cuid())

  token         String   @unique

  type          InviteType

  createdById   String?

  createdBy      User?   @relation(fields: [createdById], references: [id])

  expiresAt     DateTime?

  used          Boolean  @default(false)

  departments   InviteDepartment[]

  pendingLeader PendingLeader?

  pendingWorker PendingWorker?

  createdAt     DateTime @default(now())
}

model InviteDepartment {
  id String @id @default(cuid())

  inviteId String
  invite Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([inviteId, departmentId])
}

model PendingLeader {
  id         String @id @default(cuid())

  fullName   String
  username   String
  phone      String?
  password   String?

  status     ApprovalStatus @default(PENDING)

  inviteId   String @unique
  invite     Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  departments PendingLeaderDepartment[]

  createdAt DateTime @default(now())
}

model PendingLeaderDepartment {
  id String @id @default(cuid())

  pendingLeaderId String

  pendingLeader PendingLeader @relation(fields: [pendingLeaderId], references: [id], onDelete: Cascade)

  departmentId String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([pendingLeaderId, departmentId])
}

model PendingWorker {
  id         String @id @default(cuid())

  fullName   String
  phone      String?
  gender     String?

  status     ApprovalStatus @default(PENDING)

  inviteId   String @unique
  invite     Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  departments PendingWorkerDepartment[]

  createdAt DateTime @default(now())
}

model PendingWorkerDepartment {
  id String @id @default(cuid())

  pendingWorkerId String

  pendingWorker PendingWorker @relation(fields: [pendingWorkerId], references: [id], onDelete: Cascade)

  departmentId String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([pendingWorkerId, departmentId])
}


enum UserRole {
  ADMIN
  DEPARTMENT_LEADER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}
enum InviteType {
  LEADER
  WORKER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}