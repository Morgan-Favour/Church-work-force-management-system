generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  username          String             @unique
  password          String
  role              UserRole
  departmentId      String?
  workerId          String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdInvites    Invite[]
  leaderDepartments LeaderDepartment[]
  member            Member?
  worker            Worker?            @relation(fields: [workerId], references: [id])
}

model Member {
  id            String      @id @default(cuid())
  fullName      String
  gender        String
  phone         String      @unique
  whatsappNo    String?     @unique
  email         String?     @unique
  dateOfBirth   DateTime
  maritalStatus String
  occupation    String
  address       String
  dateJoined    DateTime
  departmentId  String?
  g12Id         String?
  workerId      String?     @unique
  userId        String?     @unique
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  department    Department? @relation(fields: [departmentId], references: [id])
  g12           G12?        @relation(fields: [g12Id], references: [id])
  user          User?       @relation(fields: [userId], references: [id])
  worker        Worker?     @relation(fields: [workerId], references: [id])
}

model MemberRegistrationLink {
  id        String   @id @default(cuid())
  token     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  description              String?
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  activities               ActivityLog[]
  attendance               Attendance[]
  inviteDepartments        InviteDepartment[]
  leaders                  LeaderDepartment[]
  members                  Member[]
  pendingLeaderDepartments PendingLeaderDepartment[]
  pendingWorkerDepartments PendingWorkerDepartment[]
  workers                  WorkerDepartment[]
}

model Worker {
  id          String             @id @default(cuid())
  fullName    String
  phone       String?            @unique
  gender      String?
  isActive    Boolean            @default(true)
  joinedAt    DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  attendance  Attendance[]
  member      Member?
  users       User[]
  departments WorkerDepartment[]
}


model G12 {
  id              String   @id @default(cuid())
  name            String   @unique
  hostLocation    String?
  hostName        String?
  leaderName      String?
  contactPhone    String?
  contactWhatsApp String?
  contactEmail    String?
  contactPerson   String?  @default("LEADER")
  isActive        Boolean  @default(true)

  members         Member[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model WorkerDepartment {
  id           String     @id @default(cuid())
  workerId     String
  departmentId String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  worker       Worker     @relation(fields: [workerId], references: [id])

  @@unique([workerId, departmentId])
}

model LeaderDepartment {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, departmentId])
}

model Service {
  id         String       @id @default(cuid())
  title      String
  date       DateTime
  createdAt  DateTime     @default(now())
  attendance Attendance[]
   archivedAt DateTime?

  @@unique([title, date])
}

model Attendance {
  id           String           @id @default(cuid())
  workerId     String
  serviceId    String
  departmentId String
  status       AttendanceStatus
  markedBy     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department       @relation(fields: [departmentId], references: [id])
  service      Service          @relation(fields: [serviceId], references: [id])
  worker       Worker           @relation(fields: [workerId], references: [id])

  @@unique([workerId, serviceId, departmentId])
}

model ActivityLog {
  id           String      @id @default(cuid())
  action       String
  description  String
  actorId      String?
  departmentId String?
  createdAt    DateTime    @default(now())
  department   Department? @relation(fields: [departmentId], references: [id])
}

model Invite {
  id            String             @id @default(cuid())
  token         String             @unique
  type          InviteType
  createdById   String?
  expiresAt     DateTime?
  used          Boolean            @default(false)
  createdAt     DateTime           @default(now())

  createdBy     User?              @relation(fields: [createdById], references: [id])
  departments   InviteDepartment[]
  pendingLeader PendingLeader?
  pendingWorkers PendingWorker[]
}

model InviteDepartment {
  id           String     @id @default(cuid())
  inviteId     String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  invite       Invite     @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@unique([inviteId, departmentId])
}

model PendingLeader {
  id          String                    @id @default(cuid())
  fullName    String
  username    String
  phone       String?
  password    String?
  status      ApprovalStatus            @default(PENDING)
  inviteId    String                    @unique
  createdAt   DateTime                  @default(now())
  invite      Invite                    @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  departments PendingLeaderDepartment[]
}

model PendingLeaderDepartment {
  id              String        @id @default(cuid())
  pendingLeaderId String
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  pendingLeader   PendingLeader @relation(fields: [pendingLeaderId], references: [id], onDelete: Cascade)

  @@unique([pendingLeaderId, departmentId])
}




model PendingWorker {
  id          String                   @id @default(cuid())
  fullName    String
  phone       String?
  gender      String?
  status      ApprovalStatus           @default(PENDING)
  inviteId    String
  createdAt   DateTime                 @default(now())

  invite      Invite                   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  departments PendingWorkerDepartment[]

  @@index([inviteId])
}


model PendingWorkerDepartment {
  id              String        @id @default(cuid())
  pendingWorkerId String
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  pendingWorker   PendingWorker @relation(fields: [pendingWorkerId], references: [id], onDelete: Cascade)

  @@unique([pendingWorkerId, departmentId])
}

enum UserRole {
  ADMIN
  DEPARTMENT_LEADER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum InviteType {
  LEADER
  WORKER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
